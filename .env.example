# Neon Console -> Connect -> Pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_SSL=true
DATABASE_CONNECTION_TIMEOUT_MS=20000

# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
QUERY_TIMEOUT_MS=8000
QUERY_ROW_LIMIT=100
