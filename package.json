{
  "name": "ai-database-chatbot",
  "version": "1.0.0",
  "description": "Schema-aware, read-only PostgreSQL chatbot",
  "main": "app/server.js",
  "scripts": {
    "start": "node app/server.js",
    "dev": "node --watch app/server.js",
    "db:push": "npm exec -- prisma db push",
    "db:generate": "npm exec -- prisma generate",
    "db:seed": "npm run db:push && node app/db/seed.js",
    "test": "node --test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@langchain/core": "^1.0.0",
    "@langchain/groq": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "@prisma/client": "^6.7.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "prisma": "^6.7.0"
  }
}
